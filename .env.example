# OctoFarm-Redux environment
#
# Copy to `.env` in the repo root and edit. Every value below is the default,
# so an empty .env is a working .env - the server writes the keys it needs back
# into the file on first start.
#
# .env is gitignored. Do not commit a filled-in copy: SUPER_SECRET_KEY is a
# credential.

# development | production | test
NODE_ENV=development

# MongoDB connection string. The monolithic Docker image runs mongod in the
# same container and sets this itself, so only change it for a bare-metal or
# external-Mongo install.
MONGO=mongodb://127.0.0.1:27017/octofarm

# Port the server listens on. In the Docker image this stays 4000 and the host
# port is mapped instead.
OCTOFARM_PORT=4000

# Browser tab / page title.
OCTOFARM_SITE_TITLE=OctoFarm

# info | debug | silly
LOG_LEVEL=info

# Session signing secret. Generated and written back here if left unset, which
# means sessions are invalidated whenever the file is lost - set it explicitly
# for a container whose .env does not persist.
# SUPER_SECRET_KEY=

# Camera proxy and hub tuning, in milliseconds. Defaults shown; leave these
# alone unless a camera is dropping or reconnecting badly.
# CAMERA_STREAM_IDLE_TIMEOUT_MS=30000
# CAMERA_HUB_LINGER_MS=15000
# CAMERA_HUB_IDLE_MS=20000
# CAMERA_HUB_RETRY_MS=2000
